{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ary-grs.dev/schemas/track-profile.schema.json",
  "title": "TrackProfile",
  "description": "Profile object returned by GET /api/track-profiles/<id-or-raceId>. The backend stores and returns the Calibrator JSON payload.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "trackId": { "type": "string" },
    "name": { "type": "string" },
    "lanes": { "type": "array" },
    "centerline": { "type": "array" },
    "background": { "type": "object" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
