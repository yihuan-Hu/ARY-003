# =============================================
# ARY 环境变量清单
# =============================================
# 复制此文件为 .env 并填入真实值
# 所有标记为 <generate-randomly> 的必须用安全随机值替换
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"

# ---- 必填：安全密钥（未设置或为默认值将拒绝启动）----
ARY_SECRET_KEY=<generate-randomly>
ARY_SUBMISSION_SECRET=<generate-randomly>

# ---- 必填：CORS 白名单（生产环境禁止使用 *）----
ARY_CORS_ORIGINS=https://your-domain.com

# ---- 数据库 ----
ARY_DATABASE_PATH=/data/ary.db

# ---- JWT ----
ARY_JWT_EXPIRATION_HOURS=1

# ---- Gunicorn（可选）----
ARY_WORKERS=4
ARY_LOG_LEVEL=info

# ---- Nginx 端口（可选）----
ARY_HTTP_PORT=80

# ---- GitHub OAuth（可选）----
GITHUB_OAUTH_CLIENT_ID=<from-github>
GITHUB_OAUTH_CLIENT_SECRET=<from-github>

# ---- 开发模式（本地测试用，生产环境不要设置）----
# ARY_DEV_MODE=1
# ARY_DEV_ADMIN_USERNAME=admin
# ARY_DEV_ADMIN_PASSWORD=
